# application-secret.yml.example
#
# 이 파일을 복사해서 application-secret.yml 을 만든 뒤 값을 채우세요:
#   cp application-secret.yml.example application-secret.yml
#
# application.yml 이 `spring.config.import: optional:classpath:application-secret.yml`
# 로 이 파일을 읽습니다. 실제 application-secret.yml 은 .gitignore 처리되어
# 커밋되지 않습니다.

# --- MySQL ---
# docker-compose.yml 의 MYSQL_ROOT_PASSWORD 와 반드시 동일하게 맞추세요.
DB_PASSWORD: localpassword

# --- JWT (HS256 → 최소 32바이트/32자 이상 필요) ---
# 운영용은 새로 생성하세요:  openssl rand -base64 48
JWT_SECRET_KEY: local-dev-only-jwt-secret-change-me-0123456789abcdefghij

# --- OAuth2 (Google / Naver / Kakao) ---
# 실제 자격증명이 없으면 아래 dummy 값을 그대로 두세요.
#   → 컨텍스트는 정상 부팅되고 ID/PW 로그인은 동작합니다.
#   → 실제 소셜 로그인은 진짜 값을 넣은 뒤에만 동작합니다.
# 각 콘솔의 Redirect URI 는: http://localhost:8080/login/oauth2/code/{google|naver|kakao}
GOOGLE_CLIENT_ID: dummy
GOOGLE_CLIENT_SECRET: dummy
NAVER_CLIENT_ID: dummy
NAVER_CLIENT_SECRET: dummy
KAKAO_CLIENT_ID: dummy
KAKAO_CLIENT_SECRET: dummy

# --- (선택) 이메일 인증용 SMTP ---
# 비워두면 메일 전송만 안 될 뿐 부팅/로그인에는 영향 없습니다.
# email:
#   username: your-gmail@gmail.com
#   password: your-app-password
